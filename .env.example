# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.
# Find both LaunchDarkly values under the gear icon (Organization settings) > SDK keys,
# after selecting your project and environment.

# Browser SDK, used by the page from step 1. Not a secret, but kept out of git anyway.
LD_CLIENT_SIDE_ID=

# Server-side SDK and AI SDK, used by the server and the traffic script. Secret.
LD_SDK_KEY=

# Optional. An Anthropic API key, so the chat box calls Claude.
# Leave blank and the chat box runs in echo mode, with no model call.
MODEL_API_KEY=
